{
  "name": "cartouche",
  "private": true,
  "license": "MIT",
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:wasm": "cd ../gb-core && cargo watch -s 'wasm-pack build --target web --out-dir pkg'",
    "dev:full": "concurrently \"npm run dev:wasm\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test 'src/**/*.test.ts'",
    "preview": "vite preview",
    "generate-gamedb": "cd .. && npx tsx scripts/generate-gamedb.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/vite": "^4.2.1",
    "qr": "^0.7.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.0.0",
    "tailwindcss": "^4.2.1",
    "trystero": "^0.25.4",
    "uqr": "^0.1.3",
    "vite-plugin-wasm": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.0"
  }
}
